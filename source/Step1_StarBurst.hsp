//Step1
//直接法のほうが綺麗なことがわかったのでさらに綺麗さを追求&最適化
//色は波長→RGBを等色関数で計算をする
//これによって入力スペクトルにしたがっていろんな色の光芒が作れるように
//double型,float型指定可能
//画像サイズは256～2048。FFT使ってないので2べきじゃなくてもよい
//入力画像は黒い部分が遮蔽、白が光を透過。白い部分が多いほど計算時間が増える
//FFTの高速化は標本サイズの制限が出るので実装しない予定
//中間出力はraw float32 RGBをbin保存し、Pythonで最終png/exrを生成する
//
//Runtime args:
//  input=path/to/mask.png
//  distance=0.000001
//  gxy=0.00000002
//  z0=0.000005
//  ox=4096
//  oy=4096
//  splitn=30
//  spec=white|warm|cool|daylight|tungsten|candle|sunset|amber|teal|cyan|green|blue_soft|blue_hard|purple|extreme_red|extreme_yellow|extreme_green|extreme_cyan|extreme_blue|extreme_violet
//  specvals=1,1,1,...   ; splitn個ぶんの厳密値
//  specfile=spec.csv    ; wavelength,intensity のCSV
//  tag=my_run_name

#const double lambda 0.000000800
#const double distance_first 0.000001
#const int DOUBLEON 0
#const int SPEC_POINT_N 10

#include "col390to830.hsp"
#include "HSPCL64.as"
#include "Step1_ParamsAndSpectrum.as"

OX_default=1024
OY_default=1024
split_n_default=30//光の波長1オクターブを何分割するか
OX=OX_default
OY=OY_default
split_n=split_n_default

python_exe="C:\\Python313\\python.exe"
input_path=dir_exe+"\\input.png"
run_tag=""
spec_name="white"//入力スペクトルのプリセット名
spec_mode=0
spec_values_raw=""
spec_file_path=""

z0xyScale_default=0.000005
z0xyScale=z0xyScale_default
g_xyScale_default=0.00000002
g_xyScale=g_xyScale_default
distance=distance_first

kernel_path=dir_exe+"\\StarBurst.cl"
postprocess_path=dir_exe+"\\postprocess.py"
runStem=""
rawBinPath=""
cmdline_raw=""
cmdline_raw=dir_cmdline
argToken=""
sample_wave=0.0
sample_value=0.0

if cmdline_raw!="" : gosub *parseCommandLine
gosub *resolveInputPath
gosub *resolveSpecFilePath
gosub *validateRuntimeParams
gosub *buildRunStem

	typesize=4+4*DOUBLEON
	splitIntensity=1.0/powf(0.5,1.0/split_n)
	//split_nごとのlintは固定配列ではなくスペクトル定義から生成する
	gosub *initSpectrumWaves
	if spec_mode=0 : gosub *setSpectrumPreset
	gosub *buildSpectrumWeights

	HCLinit
	HCLSetDevice 0
	buffer 1
	picload input_path
	gsel1x=ginfo(12)
	gsel1y=ginfo(13)

	z0xyScale=z0xyScale*512.0/double(min64(OX,OY))
	g_xyScale=g_xyScale*512.0/double(min64(gsel1x,gsel1y))

	scrn=HCLCreateBuffer(INT64(OX)*OY*split_n*typesize*2)
	scrnAddLight=HCLCreateBuffer(OX*OY*typesize*3)
	sumVal=HCLCreateBuffer(1*typesize)
	colFuncBuf=HCLCreateBuffer(split_n*typesize*3)
	gosub *CalccolFuncBuf

	prgid=HCLCreateProgram(kernel_path,"-D DOUBLEON="+DOUBLEON+" -D OX="+OX+" -D OY="+OY+" -D IX="+gsel1x+" -D IY="+gsel1y+" -D SPLIT_N="+split_n+" -D INTENSITYW="+splitIntensity+"")
	krnDiff=HCLCreateKernel(prgid,"Diffraction")
	krnAddLight=HCLCreateKernel(prgid,"AddLight")
	krnSumReduction=HCLCreateKernel(prgid,"SumReduction")

	gosub *main
	end

//1つの距離について、全波長合計計算→保存
*main
	gsel 1
		repeat gsel1y
		y=cnt
			repeat gsel1x
			x=cnt
			pget x,y
			if ginfo_r<128 : continue
			gosub *batch
			HCLFlush
			await 0
			loop
		loop
	//光の強度計算し合計
	HCLSetKrns krnAddLight,scrn,scrnAddLight,colFuncBuf
	HCLDoKrn1_sub krnAddLight,OX*OY,64
	
	//全波長 光の強度合計しおわった
	gosub *view
	gosub *saveRawFloat
	gosub *runPostprocess
	return

*batch
	HCLSetKernel krnDiff,0,scrn
	if DOUBLEON==1 {
		HCLSetKernel krnDiff,1,z0xyScale
		HCLSetKernel krnDiff,2,z0xyScale
		HCLSetKernel krnDiff,3,distance
		HCLSetKernel krnDiff,4,3.1415926535*2.0/lambda
		HCLSetKernel krnDiff,5,g_xyScale*(x-gsel1x/2)
		HCLSetKernel krnDiff,6,g_xyScale*(y-gsel1y/2)
	}else{
		HCLSetKernel krnDiff,1,float(z0xyScale)
		HCLSetKernel krnDiff,2,float(z0xyScale)
		HCLSetKernel krnDiff,3,float(distance)
		HCLSetKernel krnDiff,4,float(3.1415926535*2.0/lambda)
		HCLSetKernel krnDiff,5,float(g_xyScale*(x-gsel1x/2))
		HCLSetKernel krnDiff,6,float(g_xyScale*(y-gsel1y/2))
	}
	
	HCLDoKrn1_sub krnDiff,OX*OY,64
	return

*view
	//リダクションノーマライズ
	HCLSetKrns krnSumReduction,scrnAddLight,sumVal
	HCLSetKernel krnSumReduction,2,0,typesize*1024
	HCLDoKrn1 krnSumReduction,1024,1024
	
	floatAddLight=HCLCreateBuffer(OX*OY*4*3)
	if DOUBLEON==1{
		HCLDoXd "F0[i]=(float)A[i]/B[0];",scrnAddLight,sumVal,floatAddLight
	}else{
		HCLDoXf "F0[i]=(float)A[i]/B[0];",scrnAddLight,sumVal,floatAddLight
	}
	HCLdim_fpFromBuffer fout,floatAddLight
	return

*saveRawFloat
	rawBinPath=dir_exe+"\\z_"+runStem+".bin"
	dim fout2,OX*OY*3
	memcpy fout2,fout,OX*OY*3*4
	bsave rawBinPath,fout2
	return

*runPostprocess
	cmdline="\""+postprocess_path+"\" \""+rawBinPath+"\" "+OX+" "+OY
	exec "\""+python_exe+"\" "+cmdline
	return

*CalccolFuncBuf
	//830-390のうち
	//800-400を計算
	lm_=787.0
	
	if DOUBLEON==1{
		ddim host_colFuncBuf,split_n*3
	}else{
		fdim host_colFuncBuf,split_n*3
	}
		repeat split_n
		ilm_=int(lm_*10.0+0.5)
		ilm_-=3900
		if DOUBLEON==1{
			host_colFuncBuf.(cnt*3+0)=funcr.ilm_*lint.cnt
			host_colFuncBuf.(cnt*3+1)=funcg.ilm_*lint.cnt
			host_colFuncBuf.(cnt*3+2)=funcb.ilm_*lint.cnt
		}else{
			host_colFuncBuf.(cnt*3+0)=float(funcr.ilm_*lint.cnt)
			host_colFuncBuf.(cnt*3+1)=float(funcg.ilm_*lint.cnt)
			host_colFuncBuf.(cnt*3+2)=float(funcb.ilm_*lint.cnt)
		}
		lm_/=splitIntensity
		loop
	HCLWriteBuffer colFuncBuf,host_colFuncBuf
	return